# Required
DATABASE_URL=postgres://ddrive:ddrive@127.0.0.1:5429/ddrive
WEBHOOKS= # comma-separated webhook URLs (or use webhook.txt, one URL per line)

# Optional (defaults shown)
PORT=3000
AUTH=admin:admin
REQUEST_TIMEOUT=60000   # ms; increase if you have a slow connection
CHUNK_SIZE=10485248     # bytes; 10MiB-512 (Discord limit=10MiB total body, multipart overhead=214-263B)
UPLOAD_CONCURRENCY=3    # parallel chunk uploads; increase for faster upload at higher CPU cost
SECRET=                 # set to enable AES-256 encryption (high CPU usage)
PUBLIC_ACCESS=          # unset: no public access (auth required); READ_ONLY_FILE or READ_ONLY_PANEL

# S3 Compatible API (set both keys to enable)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=ddrive
